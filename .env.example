# ---- Appwrite (cloud storage + database) ----
# https://nyc.cloud.appwrite.io/v1  (server-side API key with databases/storage files)
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# ---- Whisper (auto-captions) — optional: free/local faster-whisper ----
# pip install faster-whisper     (required once; models auto-download on first use)
# In Docker this is preinstalled (tiny model pre-fetched); on bare metal create
# a venv and set PYTHON to it.
# Model size vs RAM: tiny (~300MB peak, fastest) · base · small (best quality,
# wants ~1GB+ — use on a real machine or paid instance) · medium | large-v3
SP_WHISPER_MODEL=small
# SP_WHISPER_TIMEOUT_MS=120000   # abort slow transcriptions instead of hanging a clip
# PYTHON=/path/to/venv/bin/python3   (only if python3 isn't the Whisper env)

# ---- YouTube (Google Cloud) ----
# https://console.cloud.google.com → enable "YouTube Data API v3"
# Create OAuth client (Web) and add this redirect URI exactly:
#   http://localhost:8787/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8787/auth/youtube/callback

# ---- Twitch (chat autopilot) — optional ----
# Leave blank for anonymous read-only. Add a bot account + OAuth for replies.
# TWITCH_CHANNEL=yourtwitch     # channel to watch
# TWITCH_CLIENT_ID=             # your Twitch app client ID
# TWITCH_BOT_USER=              # bot account username
# TWITCH_BOT_OAUTH=oauth:...    # bot OAuth (chat:read chat:edit)

# ---- Kick (chat autopilot) — read-only, no key needed ----
# KICK_CHANNEL=yourkick

# ---- TikTok ----
# TikTok API is private/partnered. We read live comments via the community
# library (TikTokLive) which needs no official key. Reserved for future TikTok
# upload access.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- App / run-anywhere ----
PORT=8787
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:8787        # or https://your.domain for an always-on server
# DATA_DIR=/app/data                 # where videos/settings persist (Docker mounts here)

# ---- Free VPS installer (scripts/setup-vps.sh) ----
# SP_DOMAIN=your.domain              # optional custom domain
# SP_WHISPER_MODEL=small             # caption model (tiny|base|small|medium|large-v3)
