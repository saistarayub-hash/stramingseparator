# ---- Appwrite (cloud storage + database) ----
# https://nyc.cloud.appwrite.io/v1  (server-side API key with databases/storage files)
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# ---- Whisper (auto-captions) — optional: free/local faster-whisper ----
# pip install faster-whisper     (required once; models auto-download on first use)
SP_WHISPER_MODEL=small

# ---- YouTube (Google Cloud) ----
# https://console.cloud.google.com → enable "YouTube Data API v3"
# Create OAuth client (Web) and add this redirect URI exactly:
#   http://localhost:8787/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8787/auth/youtube/callback

# ---- TikTok ----
# TikTok API is private/partnered. We read live comments via the community
# library (TikTokLive) which needs no official key. Reserved for future TikTok
# upload access.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- App ----
PORT=8787
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:8787
